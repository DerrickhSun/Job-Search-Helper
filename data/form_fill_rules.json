{
  "schema_version": 1,
  "documentation": "Rules drive LinkedIn Easy Apply auto-fill and Greenhouse checkbox groups (same file). Within each list, the FIRST matching rule wins. Labels are normalized: lowercased and runs of whitespace collapsed to a single space. Matching: all_substrings = every string must appear as a substring; any_substrings = at least one; all_of_any = list of groups — from each group at least one substring must appear; not_substrings = none of these may appear; starts_with = label must start with this text (after normalization); regex = Python regex (default case-insensitive). Results: screening_yes_no uses answer 'Yes' or 'No' for Yes/No radio groups (including LinkedIn ``data-test-form-builder-radio-button-form-component`` fieldsets — legend text is matched, then the option with that label is clicked). Text/select results use type literal, literal_fallbacks, literal_from_apply_source (same ``when`` map as checkbox_groups for free-text fields), name_part, resume_key_list, cover_letter_full, cover_letter_truncated. checkbox_groups: match is the fieldset legend; choose_label is the visible option label. For **How did you hear** when the answer depends on apply channel, use choose_label_from_apply_source on checkbox fieldsets or literal_from_apply_source on text inputs; apply_source is greenhouse for ``--site greenhouse`` and linkedin for LinkedIn Easy Apply. Example: regex \"location\\\\[\" matches Workday-style Location[...] labels.",
  "screening_yes_no": [
    {
      "id": "age_18_or_older",
      "comment": "Age of majority / legal age for employment",
      "match": {
        "all_substrings": ["18"],
        "any_substrings": ["or older", "years of age", "at least 18", "least 18", "age 18", "are you 18"]
      },
      "answer": "Yes"
    },
    {
      "id": "us_work_auth_without_sponsorship",
      "comment": "Authorized in US without sponsorship (LinkedIn often says 'without the need for sponsorship')",
      "match": {
        "all_substrings": ["authorized", "united states", "sponsorship"],
        "any_substrings": ["without the need", "without sponsorship", "not require sponsorship", "no sponsorship"]
      },
      "answer": "Yes"
    },
    {
      "id": "legally_authorized_us_any_employer",
      "comment": "Legally authorized to work in the US for any employer (optional trailing *)",
      "match": {
        "all_substrings": ["legally authorized", "united states", "any employer"]
      },
      "answer": "Yes"
    },
    {
      "id": "authorized_to_work_in_united_states",
      "comment": "Currently authorized to work in the United States (without requiring sponsorship phrasing in first rule)",
      "match": {
        "all_substrings": ["authorized", "united states"],
        "any_substrings": ["work in", "to work", "currently authorized", "employed in", "accept employment"],
        "not_substrings": ["any employer"]
      },
      "answer": "Yes"
    },
    {
      "id": "us_citizen",
      "comment": "Are you a US / U.S. / United States citizen (or equivalent phrasing)",
      "match": {
        "all_substrings": ["citizen"],
        "any_substrings": [
          "us citizen",
          "u.s. citizen",
          "u.s citizen",
          "united states citizen",
          "citizen of the united states",
          "citizen of the us",
          "citizen of the usa",
          "american citizen",
          "citizenship in the united states",
          "citizenship in the us"
        ]
      },
      "answer": "Yes"
    },
    {
      "id": "require_employment_visa_sponsorship_future",
      "comment": "Will you now or in the future require employment visa sponsorship in the US (optional *)",
      "match": {
        "all_substrings": ["sponsorship", "united states"],
        "any_substrings": [
          "now or in the future",
          "require employment visa",
          "employment visa sponsorship"
        ]
      },
      "answer": "No"
    },
    {
      "id": "sponsorship_need_now_or_future",
      "comment": "Other visa / sponsorship need now or in the future — answer No",
      "match": {
        "all_substrings": ["sponsorship"],
        "any_substrings": [
          "now or in the future",
          "in the future need",
          "will you need",
          "require sponsorship",
          "need sponsorship",
          "now, or will you",
          "will you in the future"
        ],
        "not_substrings": ["require employment visa", "employment visa sponsorship"]
      },
      "answer": "No"
    },
    {
      "id": "sponsorship_and_visa_terms",
      "comment": "Visa / employment sponsorship",
      "match": {
        "all_of_any": [
          ["sponsorship", " sponsor", "sponsor "],
          ["visa", "h-1", "h1b", "h1-b", "immigration", "employment visa"]
        ]
      },
      "answer": "No"
    },
    {
      "id": "sponsorship_need_will",
      "comment": "Sponsorship + require/will you (do not use plain 'need' — it matches 'without the need for sponsorship')",
      "match": {
        "all_substrings": ["sponsorship"],
        "any_substrings": ["require", "requiring", "will you", "will we need to sponsor", "need sponsorship", "need a visa", "need visa", "need h-1", "need h1b"]
      },
      "answer": "No"
    },
    {
      "id": "scalable_cloud_infrastructure_experience",
      "comment": "Developing/maintaining scalable cloud infrastructure (typos like infrasture)",
      "match": {
        "all_substrings": ["experience", "cloud", "scalable"],
        "any_substrings": ["developing", "maintaining", "infrastructure", "infrasture"]
      },
      "answer": "No"
    },
    {
      "id": "proficient_in_python",
      "comment": "Proficiency in Python screening",
      "match": {
        "regex": "\\bproficient\\b.{0,120}\\bpython\\b|\\bpython\\b.{0,120}\\bproficient\\b"
      },
      "answer": "Yes"
    },
    {
      "id": "willing_to_relocate",
      "comment": "Willing to relocate / relocation",
      "match": {
        "all_substrings": ["relocat"],
        "any_substrings": ["willing to", "would you be willing", "willing"]
      },
      "answer": "Yes"
    },
    {
      "id": "on_site_acknowledge_commute_relocate",
      "comment": "Acknowledge on-site role; willing to commute and/or relocate (optional *)",
      "match": {
        "all_substrings": ["acknowledge"],
        "all_of_any": [
          ["on-site", "on site"],
          ["commute", "relocate"]
        ]
      },
      "answer": "Yes"
    },
    {
      "id": "relatives_at_employer",
      "comment": "Relatives / family employed there",
      "match": {
        "all_of_any": [
          ["relative", "relatives", "family member"],
          ["employed", "work", "working"]
        ]
      },
      "answer": "No"
    },
    {
      "id": "previously_employed_by",
      "comment": "Previously employed by this company",
      "match": { "all_substrings": ["employed by"] },
      "answer": "No"
    },
    {
      "id": "authorized_to_work",
      "comment": "US work authorization",
      "match": { "all_substrings": ["authorized", "work"] },
      "answer": "Yes"
    },
    {
      "id": "start_immediately",
      "comment": "Availability — start immediately",
      "match": {
        "all_substrings": ["immediately"],
        "any_substrings": ["start", "begin"]
      },
      "answer": "Yes"
    }
  ],
  "text_inputs": [
    {
      "id": "hear_about_free_text",
      "comment": "Greenhouse-style free-text 'How did you hear' (not checkbox fieldset)",
      "match": { "regex": "how\\s+did\\s+you\\s+hear" },
      "result": {
        "type": "literal_from_apply_source",
        "when": {
          "greenhouse": "Greenhouse",
          "linkedin": "LinkedIn",
          "default": "LinkedIn"
        }
      }
    },
    {
      "id": "current_location",
      "comment": "What is your current location? (optional trailing *)",
      "match": { "all_substrings": ["current location"] },
      "result": {
        "type": "literal",
        "value": "San Diego, California, United States"
      }
    },
    {
      "id": "where_are_you_located",
      "comment": "Free-text location; try formats until the widget accepts one",
      "match": {
        "all_substrings": ["where"],
        "any_substrings": ["you located", "your location", "where are you", "where do you live"],
        "not_substrings": ["current location"]
      },
      "result": {
        "type": "literal_fallbacks",
        "values": [
          "San Diego, California, United States",
          "California, United States",
          "United States",
          "California"
        ]
      }
    },
    {
      "id": "first_name",
      "match": { "any_substrings": ["first name", "given name"] },
      "result": { "type": "name_part", "part": "first" }
    },
    {
      "id": "last_name",
      "match": { "any_substrings": ["last name", "surname", "family name"] },
      "result": { "type": "name_part", "part": "last" }
    },
    {
      "id": "email",
      "match": { "all_substrings": ["email"] },
      "result": { "type": "resume_key_list", "keys": ["email"] }
    },
    {
      "id": "phone",
      "match": { "any_substrings": ["phone", "mobile"] },
      "result": { "type": "resume_key_list", "keys": ["phone"] }
    },
    {
      "id": "desired_base_salary",
      "comment": "Desired / expected / base compensation (numeric)",
      "match": {
        "all_substrings": ["salary"],
        "any_substrings": ["desired", "base salary", "expected salary", "compensation", "pay expectation"]
      },
      "result": { "type": "literal", "value": "80000" }
    },
    {
      "id": "city_state_currently_reside",
      "comment": "City + state + reside; must match before generic city_blank",
      "match": {
        "all_substrings": ["city", "state"],
        "any_substrings": ["currently reside", "you currently", "do you currently", "which city and state"]
      },
      "result": { "type": "literal", "value": "San Diego, California, United States" }
    },
    {
      "id": "location_bracket",
      "comment": "Labels like Location[...] (Workday-style); must run before city_blank if label contains 'city'",
      "match": { "regex": "location\\[" },
      "result": { "type": "literal", "value": "San Diego, California, United States" }
    },
    {
      "id": "location_city",
      "comment": "LinkedIn/Workday Location (city) / Location (city)* — autocomplete; press Enter after fill",
      "match": { "regex": "location\\s*\\(\\s*city\\s*\\)(?:\\s*\\*)?" },
      "result": {
        "type": "literal",
        "value": "San Diego, California, United States",
        "press_enter_after_fill": true
      }
    },
    {
      "id": "city_blank",
      "comment": "Other city-only prompts — leave blank when not covered above",
      "match": { "all_substrings": ["city"], "not_substrings": ["location"] },
      "result": { "type": "literal", "value": "" }
    },
    {
      "id": "linkedin_url",
      "match": { "all_substrings": ["linkedin"] },
      "result": { "type": "resume_key_list", "keys": ["linkedin", "linkedin_url"] }
    },
    {
      "id": "github_url",
      "match": { "all_substrings": ["github"] },
      "result": { "type": "resume_key_list", "keys": ["github_url", "github"] }
    },
    {
      "id": "portfolio_url",
      "match": { "all_substrings": ["portfolio"] },
      "result": { "type": "resume_key_list", "keys": ["portfolio_url", "portfolio"] }
    },
    {
      "id": "website_url",
      "match": { "all_substrings": ["website"] },
      "result": { "type": "resume_key_list", "keys": ["website", "website_url", "personal_website"] }
    }
  ],
  "textareas": [
    {
      "id": "cover_letter",
      "match": { "all_substrings": ["cover"] },
      "result": { "type": "cover_letter_full" }
    },
    {
      "id": "additional_message",
      "match": { "any_substrings": ["additional", "message"] },
      "result": { "type": "cover_letter_truncated", "max_length": 500 }
    }
  ],
  "selects": [
    {
      "id": "marketing_opt_in",
      "match": { "starts_with": "would you like to receive" },
      "result": { "type": "literal", "value": "No" }
    }
  ],
  "checkbox_groups": [
    {
      "id": "hear_about_source",
      "comment": "How did you hear — Greenhouse flow vs LinkedIn Easy Apply (apply_source on FormFillRulesEngine)",
      "match": {
        "regex": "how\\s+did\\s+you\\s+hear"
      },
      "choose_label_from_apply_source": {
        "greenhouse": "Greenhouse",
        "linkedin": "LinkedIn",
        "default": "LinkedIn"
      }
    }
  ]
}
